# Copy to .env at the repository root. The application and docker compose both
# read it, and git ignores it. Every value is optional unless marked; a line left
# commented out keeps the default it shows.

# Database, for docker compose and the application. BRIDGE_DB_PORT serves the
# demonstration version, BRIDGE_PROD_DB_PORT the prod profile.
BRIDGE_DB_NAME=bridge
BRIDGE_DB_USER=bridge
BRIDGE_DB_PASSWORD=bridge
BRIDGE_DB_PORT=5432
BRIDGE_PROD_DB_PORT=5433
# Any other PostgreSQL database; overrides the ports.
# BRIDGE_DB_URL=jdbc:postgresql://localhost:5432/bridge

# HTTP port of the application.
# BRIDGE_PORT=8080

# Signing key for the access tokens, at least 32 characters.
# Required by the prod profile; the demonstration version has a default.
# BRIDGE_JWT_SECRET=

# Where uploaded CVs are written.
# Default ./storage/cv, and ./storage/prod/cv under the prod profile.
# BRIDGE_CV_DIR=

# true for one start empties the database and reloads the demonstration data.
BRIDGE_DEMO_RESET=false

# The first recruiter, created when none exists; required by the prod profile.
# The password follows the password policy and is changed at first sign in.
# BRIDGE_ADMIN_EMAIL=
# BRIDGE_ADMIN_PASSWORD=
# BRIDGE_ADMIN_FIRST_NAME=Admin
# BRIDGE_ADMIN_LAST_NAME=Bridge

# Google sign in: the client ID of an OAuth client of type "Web application",
# ending in .apps.googleusercontent.com. Empty hides the Google button. No client
# secret is used.
BRIDGE_GOOGLE_CLIENT_ID=
